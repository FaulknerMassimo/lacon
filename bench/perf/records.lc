type Person {name str, age int, score int}

fn main() =
  var people = []
  var seed = 7
  for i in 0..600000:
    seed = (seed * 1103515245 + 12345) % 2147483648
    people.push(Person{"p{i}", seed % 90, seed / 7 % 1000})
  adults = people.filter(it.age >= 18).sort_by(-it.score)
  total = adults.map(it.score).sum()
  print("{adults.len} {total} {adults[0].name} {adults[-1].name}")
