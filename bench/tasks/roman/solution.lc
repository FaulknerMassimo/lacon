VALS = [(1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"), (50, "L"), (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")]
DIGITS = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}

fn to_roman(n int) str =
  var n = n
  var out = ""
  for (v, s) in VALS:
    while n >= v:
      out += s
      n -= v
  out

fn from_roman(s str) int =
  var total = 0
  for i, c in s.chars.enumerate():
    v = DIGITS[c]
    if i + 1 < s.len and DIGITS[s[i + 1]] > v: total -= v
    else: total += v
  total

fn convert(line str) str =
  if !line.is_empty() and line.chars.all(it.is_digit()):
    n = int(line) ?? 0
    return if n >= 1 and n <= 3999: to_roman(n) else: "invalid"
  if !line.is_empty() and line.chars.all(it in DIGITS):
    n = from_roman(line)
    if n >= 1 and n <= 3999 and to_roman(n) == line: return str(n)
  "invalid"

fn main() =
  for line in io.lines():
    print(convert(line))
