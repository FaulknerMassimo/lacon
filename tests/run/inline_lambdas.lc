# A lambda given straight to `map`, `filter` or `sort_by` runs inlined in a
# loop when the receiver is a list, and as a closure when it isn't. Both
# must match the interpreter: captures, `?` and `return`, and errors.
type P {name str, age int, score int}

fn scale(xs [int], k int) [int] = xs.map(it * k)

fn parse_all(xs [str]) [int]! = xs.map(int(it)?)

fn first_neg(xs [int]) int =
  xs.filter(if it < 0: return it else: true).len

fn main() =
  ps = [P{"a", 30, 5}, P{"b", 12, 9}, P{"c", 45, 5}, P{"d", 18, 1}, P{"e", 70, 9}]
  adults = ps.filter(it.age >= 18)
  print(adults.map(it.name), adults.sort_by(-it.score).map(it.name), ps.sort_by(it.name > "b").map(it.name))
  # Captures, from the function and through an enclosing lambda.
  base = 100
  print(scale([1, 2, 3], 3), [1, 2].map(it + base), [[1, 2], [3]].map(|row| row.map(it * base + row.len)))
  # Packed lists, and an empty one.
  print([3, 1, 2].sort_by(-it), [0.5, 1.5].map(it * 2.0), [true, false, true].filter(it), [].map(it + 1), [1, 2].filter(it > 5))
  # Receivers that aren't lists go through the closure.
  print((1..5).map(it * it), {"x": 1, "y": 2}.map(it.1), {3, 1, 2}.filter(it > 1).sort_by(it), "bca".sort_by(it))
  # Keys that aren't ints, and ints mixed with floats.
  words = ["pear", "fig", "apple", "kiwi", "plum"]
  print(words.sort_by(it.len), words.sort_by(it), [2, 0.5, 1].sort_by(it), words.sort_by([it.len, it]))
  # `?` and `return` inside an inlined lambda.
  print(parse_all(["1", "2"]) ?? [], parse_all(["1", "x", "3"]) ?? [-1], parse_all(["x"]).is_err(), first_neg([1, -4, -2]), first_neg([1, 2]))
  # Many int keys, sorted by radix: stable, at every range of keys.
  var seed = 7
  var pairs = []
  for i in 0..5000:
    seed = (seed * 1103515245 + 12345) % 2147483648
    pairs.push((seed % 300 - 150, i))
  big = 9223372036854775807
  wide = pairs.map((if it.1 % 3 == 0: big - 150 + it.0 elif it.1 % 3 == 1: -big - 1 + (it.1 - 1) else: it.0 * 1000000, it.1))
  for keys in [pairs, pairs.take(1000), wide, wide.take(1000)]:
    s = keys.sort_by(it.0)
    var ok = true
    for i in 1..s.len:
      if s[i - 1].0 > s[i].0 or (s[i - 1].0 == s[i].0 and s[i - 1].1 > s[i].1): ok = false
    print(s.len, ok, s[0], s[-1], s.map(it.1).sum())
  # An error inside an inlined lambda.
  print([2, 1, 0].map(10 / it))
