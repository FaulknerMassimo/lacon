# Format specs, including computed widths and precisions.
fn even(n int) bool = n % 2 == 0

fn main() =
  w = 6
  for n in ["a", "bbb"]:
    print("[{n:<{w}}] [{n:>{w}}] [{n:*^{w + 2}}]")
  d = 3
  print("{3.14159:.{d}}|{2.5:{w}.{d - 2}}|{42:0{w}}|{-7:+}|{255:x}|{3.14159:.2}")
  rows = [("apples", 3), ("kiwis", 120)]
  name_w = rows.map(it.0.len).max()
  num_w = rows.map(str(it.1).len).max()
  for (name, n) in rows:
    print("{name:<{name_w}} {n:>{num_w}}")
  # Python's map(f, xs) and filter(f, xs) mean xs.map(f) and xs.filter(f).
  xs = [1, 2, 3, 4]
  print(" ".join(map(str, xs)), filter(even, xs), map(|x| x * 10, xs), sum(map(int, ["4", "5"])))
