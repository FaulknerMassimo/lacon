# Calls of every kind around unboxed values: generics, overloads, defaults,
# `mut` parameters, early exits from loops, closures and narrowing.
type Pt {x int, y int}
enum Sh = Circle(f64) | Sq(int)

fn first[T](xs [T]) T = xs[0]
fn twice(n int) int = n * 2
fn twice(s str) str = s + s
fn add(a int, b int = 10) int = a + b
fn area(s Sh) f64 = match s
  Circle(r): 3.0 * r * r
  Sq(n): n * n
fn dbl(p Pt) Pt = Pt{p.x * 2, p.y * 2}
fn sum_to(n int) int =
  var t = 0
  for i in 0..n:
    if i == 7: break
    if i % 2 == 1: continue
    t += i
  t
fn find(xs [int], v int) int =
  for (i, x) in xs.enumerate():
    if x == v: return i
  -1
fn grow(mut xs [int], n int) =
  for i in 0..n: xs.push(i)
fn classify(n int) str = match n
  0: "zero"
  1..=9: "small"
  _: "big"

fn main() =
  print(first([3, 4]) + 1, first(["a"]), twice(4), twice("ab"), add(1), add(1, 2))
  print(area(Circle(1.0)), area(Sq(3)), dbl(Pt{1, 2}).x, Pt{3, 4}.y)
  print(sum_to(100), find([5, 6, 7], 7), find([], 1))
  var xs = [1]
  grow(xs, 3)
  print(xs, xs.len, classify(0), classify(5), classify(50))
  var p = Pt{1, 2}
  p.x += 5
  p.y = p.x * 2
  print(p, p.x + p.y)
  m = {"a": 1, "b": 2}
  var tot = 0
  for k, v in m: tot += v * k.len
  print(tot)
  n = 5
  f = |x| x + n
  print(f(1), [1, 2, 3].map(f), [1, 2, 3].filter(it > n - 4).len)
  var best = none
  for x in [3, 1, 2]:
    if best == none or x < best ?? 0: best = x
  print(best)
  s = "héllo"
  print(s.len, s[1], 3.abs(), (-3).abs(), 7.min(2), 2.5.max(3))
  var i = 10
  while i > 0 and i % 3 != 0:
    i -= 1
  print(i, (i > 5) == false)
  k = if n > 3: n else: 0
  print(k, -k, !true, 5 & 3 == 1)
