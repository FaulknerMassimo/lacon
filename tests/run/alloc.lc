# Native code takes small blocks from per-size free lists and larger ones
# from malloc. Values that grow from one to the other, change kind, or are
# freed and made again in other sizes must match the interpreter.
type Pair {a int, b str}

enum Shape = Dot | Circle(int) | Rect(int, int) | Tri(int, int, int)

fn area(s Shape) int =
  match s
    Dot: 0
    Circle(r): 3 * r * r
    Rect(w, h): w * h
    Tri(a, b, c): a + b + c

fn grow(n int) str =
  var s = ""
  for i in 0..n: s += "ab"
  s

fn main() =
  # A string appended to past the small sizes, and strings of every length.
  s = grow(400)
  print(s.len, s[0..4], s[-3..], s.len == 800)
  var total = 0
  for n in 0..700:
    t = "x".repeat(n) + "y"
    total += t.len
  print(total)
  # Lists of each kind grown past the small sizes.
  var ints = []
  var strs = []
  var bools = []
  for i in 0..300:
    ints.push(i * i)
    strs.push("s{i}")
    bools.push(i % 3 == 0)
  print(ints.len, ints[299], ints.sum(), strs[150], strs.len, bools.count(it))
  # An empty list that has room takes the kind of its next element.
  var k [int?] = [1, 2, 3]
  k.clear()
  k.push(none)
  k.push(2)
  var b [bool?] = [true, false]
  b.clear()
  b.push(none)
  b.push(true)
  var f = [0.5]
  f.pop()
  f.push(7)
  print(k, b, f)
  # Packed lists boxed in place, small and large.
  var p [int?] = [1, 2]
  p.push(none)
  var q [int?] = []
  for i in 0..200: q.push(i)
  q.push(none)
  print(p, q.len, q[199], q[-1])
  # A map grown past the small sizes, then shrunk and cleared.
  var m = {}
  for i in 0..500: m["k{i}"] = i
  for i in 0..500:
    if i % 2 == 0: m.remove("k{i}")
  print(m.len, m["k499"], m.get("k10") ?? -1)
  m.clear()
  m["again"] = 1
  print(m)
  # Many values freed and made again in other sizes.
  var shapes = []
  for i in 0..2000:
    shapes.push(match i % 4
      0: Dot
      1: Circle(i)
      2: Rect(i, 2)
      _: Tri(i, i, i))
  var sum = 0
  for s2 in shapes: sum += area(s2)
  shapes = []
  var pairs = []
  for i in 0..2000: pairs.push(Pair{i, "p{i}"})
  print(sum, pairs.len, pairs[1999], pairs.map(it.a).sum())
  adders = (0..50).map(|i| |x| x + i)
  print(adders.map(it(1)).sum())
