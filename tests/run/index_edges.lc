# Indexes at the ends of a list, through each way native code reads and
# writes an element: 0, the last, -1 and -len are in range, and -len - 1,
# the last line's, is not.

fn pick(xs [int], i int) int = xs[i]

fn main() =
  ints = [10, 20, 30]
  bools = [true, false, false]
  floats = [0.5, 1.5, 2.5]
  strs = ["a", "b", "c"]
  for i in [0, 2, -1, -3]:
    print(ints[i], bools[i], floats[i], strs[i], pick(ints, i))

  # through views
  var wi = [0, 0, 0]
  var wb = [false, false, false]
  var wf = [0.0, 0.0, 0.0]
  var ws = ["", "", ""]
  for i in [0, 2, -1, -3]:
    wi[i] += wi[i] + 1
    wb[i] = wb[i] or i < 0
    wf[i] += 0.5
    ws[i] = ws[i] + "x"
  print(wi, wb, wf, ws)

  # outside loops
  var oi = [1, 2, 3]
  oi[-1] = 7
  oi[-3] += 1
  oi[2] *= 2
  var ob = [false, false, false]
  ob[-3] = true
  var of = [1.0, 2.0, 3.0]
  of[-1] /= 2.0
  var os = ["p", "q", "r"]
  os[-3] = "s"
  print(oi, ob, of, os, oi[-3], of[-1], os[-1])

  var short = [1, 2, 3]
  for i in [-3, -4]:
    short[i] = 0
  print(short)
