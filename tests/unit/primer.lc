# Every claim in docs/primer.md, as a test.
MAX = 100

type User {name str, age u32, city str}

fn parse_line(line str) User! =
  p = line.split(",").map(it.trim())
  if p.len != 3: fail "bad line: {line}"
  User{p[0], p[1].parse()?, p[2]}

fn add(a int, b int) int = a + b
fn clamp(x int, lo int = 0, hi int = 9) int =
  if x < lo: return lo
  x.min(hi)
fn log(msg str) = print(msg)
fn biggest[T](a T, b T) T = if a > b: a else: b
fn bump(mut n int) = n += 1

type Point {x int, y int = 0}
enum Shape = Circle(f64) | Rect(f64, f64) | Empty

fn area(s Shape) f64 = match s
  Circle(r): 3.14 * r * r
  Rect(w, h): w * h
  Empty: 0.0

fn parse_all(lines [str]) [User]! = lines.map(parse_line(it)?)
fn first_even(xs [int]) int? =
  x = xs.find(it % 2 == 0)?
  x * 10
fn apply(f fn(int) int, x int) int = f(x)

test "parses": parse_line("ann, 30, Oslo")? == User{"ann", 30, "Oslo"}
test "bindings":
  var x = 0
  x += 2
  line = "  a  "
  line = line.trim()
  y = if x > 1: "big" else: "small"
  var a = 1
  var b = 2
  a, b = b, a
  c, d = (5, 6)
  (x, line, y, a, b, c, d, MAX) == (2, "a", "big", 2, 1, 5, 6, 100)
test "types and literals":
  assert [1, 2].len == 2 and {"a": 1}["a"] == 1 and {}.len == 0 and {1, 2}.len == 2
  assert set().len == 0 and (1, "a").1 == "a" and none == none
  assert 1 + 2.5 == 3.5 and 7 / 2 == 3 and int("4") == 4 and f64(2) == 2.0
  str(5) == "5" and 3.7 as int == 3 and (2 as f64) == 2.0
test "functions":
  var n = 1
  bump(n)
  assert add(1, 2) == 3 and clamp(-5) == 0 and clamp(50) == 9 and clamp(5, 0, 7) == 5
  assert biggest(3, 8) == 8 and biggest("a", "b") == "b" and n == 2
  s = Circle(1.0)
  assert s.area() == area(s) and len([1, 2, 3]) == 3 and abs(-4) == 4
  assert [3, 1].len == 2 and "a\nb".lines == ["a", "b"]
  assert apply(it + 1, 1) == 2 and [1, 2].map(|v| v * 2) == [2, 4] and [1, 2].fold(0, |a, b| a + b) == 3
  log("hi")
  true
test "structs":
  p = Point{1, 2}
  x = 1
  y = 2
  assert p == Point{x: 1, y: 2} and p == Point{x, y} and Point{7}.y == 0
  var q = p
  q.x = 5
  p.x == 1 and q.x == 5
test "patterns":
  r = match 5
    1 | 2: "low"
    n if n > 4: "big {n}"
    _: "mid"
  digit = match 7
    1..=9: "digit"
    _: "other"
  tup = match (1, 2)
    (a, _): a
  lst = match [1, 2, 3]
    [first, ..rest]: rest
    []: []
  q = match Shape.Circle(2.0)
    Shape.Circle(rad): rad
    _: 0.0
  o = match [1].get(3)
    none: "none"
    v: "some"
  e = match parse_line("x")
    err(msg): msg
    u: u.name
  (r, digit, tup, lst, q, o, e) == ("big 5", "digit", 1, [2, 3], 2.0, "none", "bad line: x")
test "control flow":
  var out = []
  for i in 0..3: out.push(i)
  for i in 0..=1: out.push(i)
  for i, x in ["a"].enumerate(): out.push(i)
  m = {"k": 9}
  for k, v in m: out.push(v)
  for k in m: assert k == "k"
  var w = 0
  while w < 10:
    w += 1
    if w == 2: continue
    if w > 4: break
  assert out == [0, 1, 2, 0, 1, 0, 9] and w == 5
  z = "yes" if w == 5 else "no"
  assert [1, 2].map(match it
    1: "one"
    _: "more") == ["one", "more"]
  z == "yes" and 1 < 2 <= 2 and 2 in [1, 2] and 3 not in [1] and (none ?? 4) == 4 and (6 & 3) == 2 and 1 << 3 == 8
test "no truthiness": !([1].is_empty()) and not false
test "errors":
  us = parse_all(["a, 1, X", "b, 2, Y"])?
  assert us.len == 2 and parse_all(["a, 1, X", "bad"]).is_err()
  assert (parse_line("bad") ?? User{"d", 0, "Z"}).name == "d"
  assert {"a": 1}.get("b") == none and [1].get(5) == none and [].first == none
  assert [1, 3].find(it > 1) == 3 and "abc".find("c") == 2 and "abc".find("z") == none
  first_even([1, 3]) == none and first_even([1, 4]) == 40
test "strings":
  name = "Ann"
  age = 30
  assert "{name} is {age}" == "Ann is 30" and "{3.14159:.2}" == "3.14" and "{7:>3}" == "  7"
  assert "{7:03}" == "007" and "{255:x}" == "ff" and "{{x}}".len == 3 and 'q' == "q"
  w = 4
  assert "{name:<{w}}|" == "Ann |" and "{age:>{w}}" == "  30" and "{1234.5:,.2f}" == "1,234.50"
  t = """
    one
      two
    """
  assert t == "one\n  two"
  s = "héllo"
  assert s.len == 5 and s[1] == "é" and s[1..3] == "él" and s[-1] == "o" and "a" + "b" == "ab" and "ab" * 2 == "abab"
  assert "a,b".split(",") == ["a", "b"] and " a  b ".split() == ["a", "b"] and " x ".trim() == "x"
  assert "Ab".upper() == "AB" and "Ab".lower() == "ab" and "aXa".replace("X", "-") == "a-a"
  assert "abc".starts_with("ab") and "abc".ends_with("bc") and "abc".contains("b")
  assert "42".parse()? == 42 and "2.5".parse()? == 2.5 and "x".parse().is_err()
  assert "ab".chars == ["a", "b"] and "ab".rev() == "ba" and "ab".repeat(2) == "abab"
  assert "7".is_digit() and "a".is_alpha() and " ".is_space() and "a".ord() == 97 and 98.chr() == "b"
  "k=v".split_once("=") == ("k", "v") and "x".split_once("=") == none and "7".pad_left(3, "0") == "007" and ["a", "b"].join(", ") == "a, b"
test "lists":
  xs = [3, 1, 2]
  assert xs.sort() == [1, 2, 3] and xs == [3, 1, 2] and xs.sort_by(-it) == [3, 2, 1]
  assert xs.first == 3 and xs.last == 2 and xs.get(1) == 1 and xs.contains(2) and xs.index(2) == 2
  assert xs.map(it * 2) == [6, 2, 4] and xs.filter(it > 1) == [3, 2] and xs.position(it == 1) == 1
  assert xs.any(it > 2) and xs.all(it > 0) and xs.count(it > 1) == 2 and xs.sum() == 6 and xs.product() == 6
  assert xs.min() == 1 and xs.max() == 3 and ["bb", "a"].min_by(it.len) == "a" and ["bb", "a"].max_by(it.len) == "bb"
  assert xs.rev() == [2, 1, 3] and [1, 1, 2].unique() == [1, 2] and xs.enumerate()[0] == (0, 3)
  assert xs.zip(["a"]) == [(3, "a")] and [[1], [2]].flatten() == [1, 2] and xs.flat_map([it, it]).len == 6
  assert xs.take(1) == [3] and xs.skip(2) == [2] and xs.take_while(it > 2) == [3] and xs.skip_while(it > 2) == [1, 2]
  assert xs.chunks(2) == [[3, 1], [2]] and xs.windows(2) == [[3, 1], [1, 2]] and xs.group_by(it % 2) == {1: [3, 1], 0: [2]}
  assert xs.partition(it > 1) == ([3, 2], [1]) and xs.reduce(|a, b| a + b) == 6 and xs.join("-") == "3-1-2"
  assert xs.to_set() == {1, 2, 3} and [("a", 1)].to_map() == {"a": 1} and xs[1..3] == [1, 2] and xs[1:3] == [1, 2]
  assert xs[-1] == 2 and xs + [9] == [3, 1, 2, 9]
  people = [("bo", 3), ("al", 3), ("cy", 9)]
  people.sort_by((-it.1, it.0)) == [("cy", 9), ("al", 3), ("bo", 3)]
test "mutators":
  var xs = [1, 2]
  xs.push(3)
  p = xs.pop()
  xs.insert(0, 0)
  r = xs.remove(1)
  xs.extend([7, 8])
  xs.swap(0, 1)
  xs.retain(it != 8)
  assert (xs, p, r) == ([2, 0, 7], 3, 1)
  xs.clear()
  var e = []
  xs.is_empty() and e.pop() == none
test "maps":
  var m = {"a": 1}
  m["b"] = 2
  m["c"] += 5
  m["l"].push(1)
  assert m["a"] == 1 and m.get("z") == none and m.get("z", 0) == 0 and "a" in m
  m.remove("l")
  assert m.keys() == ["a", "b", "c"] and m.values() == [1, 2, 5] and m.items()[0] == ("a", 1) and m.len == 3
  m.sort_by(-it.1)[0] == ("c", 5) and m.filter(it.1 > 1).to_map() == {"b": 2, "c": 5}
test "sets and ranges":
  var s = {1}
  s.add(2)
  s.remove(1)
  assert 2 in s and {1, 2} | {3} == {1, 2, 3} and {1, 2} & {2} == {2} and {1, 2} - {2} == {1}
  assert (0..3).rev().to_list() == [2, 1, 0] and (0..5).step_by(2).to_list() == [0, 2, 4]
  var h = heap([5, 1])
  h.push(3)
  var mx = heap()
  mx.push((-2, "b"))
  mx.push((-9, "a"))
  h.pop() == 1 and h.first == 3 and h.len == 2 and mx.pop() == (-9, "a") and heap().first == none
test "stdlib":
  assert math.pi > 3.14 and math.inf > 1e300 and int.max > 0 and range(0, 6, 2).to_list() == [0, 2, 4]
  assert min(3, 1) == 1 and max([1, 5]) == 5 and os.args == [] and os.env("LACON_NOPE") == none
  assert (-2).abs() == 2 and 1.min(2) == 1 and 2.pow(3) == 8 and 9.0.sqrt() == 3.0 and 2.5.floor() == 2.0
  2.5.ceil() == 3.0 and 2.4.round() == 2.0 and 15.clamp(0, 10) == 10 and fs.exists("primer.lc")
