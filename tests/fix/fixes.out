--- fixes.lc
# Each fix `lacon fix` applies that no check test shows, and one that only
# appears once an earlier fix lets the type checker run.

type User {name str, age int}
enum Shape = Circle(f64) | Square(f64)

fn older(u User) User = User{u.name, u.age + 1}

fn area(s Shape) f64 =
  match s
    Circle(r): 3.0 * r * r
    Square(_): 0.0

fn make() User = User{name: "ann", age: 3}

fn conversions(f f64, n int) =
  m int = int(f)
  s str = str(n)
  print(m, s, "{s}{n}")

fn count(s str) int! =
  t int = int(s)?
  t

fn find(xs [int], x int) int? =
  for i in 0..xs.len:
    if xs[i] == x: return none
  none

fn check(n int) int! =
  if n < 0: fail "negative"
  n

fn next(n int) int =
  return n + 1

fn parsed(s str) int! =
  n = count(s)
  n? * 2

fn main() =
  print(older(make()), area(Circle(1.0)), find([1], 1), check(1)?, next(1), parsed("2")?)
  os.exit(0)
